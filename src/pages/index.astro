---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';

const schemaOrg = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Running et Trail",
  "url": "https://running-et-trail.fr",
  "description": "Le magazine en ligne de la course à pied et du trail running. Articles, portraits d'athlètes, guides entraînement et nutrition.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://running-et-trail.fr/recherche?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
});
---

<BaseLayout
  title="Running et Trail - Le magazine de la course à pied et du trail running"
  description="Articles, portraits d'athlètes, guides entraînement et nutrition pour la course à pied et le trail running. Plans marathon, ultra-trail, récupération et conseils pratiques."
  canonical="/"
  schema={schemaOrg}
>

<!-- Hero éditorial -->
<section class="hero">
  <div class="container">
    <p style="font-size:0.9rem;text-transform:uppercase;letter-spacing:0.12em;color:var(--primary);font-weight:700;margin-bottom:16px;">Le magazine du trail et de la course à pied</p>
    <h1>Entraînement, nutrition et portraits d'athlètes</h1>
    <p>Plans d'entraînement, guides nutrition, récits de course et portraits des plus grands noms du trail et de l'ultra-trail. Tout pour progresser, du 10 km à l'ultra.</p>
    <div class="hero-cta">
      <a href="/articles" class="btn btn-primary">Lire nos articles</a>
      <a href="/athletes" class="btn btn-secondary">Portraits d'athlètes</a>
    </div>
  </div>
</section>

<!-- Articles à la une -->
<section class="section">
  <div class="container">
    <h2 class="section-title">À la une</h2>
    <p class="section-subtitle">Nos derniers guides et articles pour progresser en course à pied et trail running.</p>
    <div class="articles-grid">
      <a href="/articles/plan-entrainement-marathon" class="article-card fade-in">
        <div style="width:100%;height:200px;background:linear-gradient(135deg,#1a1a2e,#16213e);display:flex;align-items:center;justify-content:center;">
          <span style="font-family:var(--font-heading);font-weight:800;font-size:0.85rem;color:var(--primary);text-transform:uppercase;letter-spacing:0.08em;">Entraînement</span>
        </div>
        <div class="article-card-content">
          <span class="article-card-tag">Entraînement</span>
          <h3>Plan entraînement marathon : 16 semaines pour performer</h3>
          <p>Plan détaillé semaine par semaine pour préparer votre marathon. Objectifs sub-4h et sub-3h30.</p>
        </div>
      </a>
      <a href="/articles/debuter-trail" class="article-card fade-in">
        <div style="width:100%;height:200px;background:linear-gradient(135deg,#0d3b0d,#1a5c1a);display:flex;align-items:center;justify-content:center;">
          <span style="font-family:var(--font-heading);font-weight:800;font-size:0.85rem;color:var(--primary);text-transform:uppercase;letter-spacing:0.08em;">Trail</span>
        </div>
        <div class="article-card-content">
          <span class="article-card-tag">Trail</span>
          <h3>Débuter le trail running : équipement, nutrition et entraînement</h3>
          <p>Guide complet pour passer de la route aux sentiers. Chaussures, sac, plan d'entraînement et erreurs à éviter.</p>
        </div>
      </a>
      <a href="/articles/nutrition-marathon" class="article-card fade-in">
        <div style="width:100%;height:200px;background:linear-gradient(135deg,#2d1b00,#4a2c00);display:flex;align-items:center;justify-content:center;">
          <span style="font-family:var(--font-heading);font-weight:800;font-size:0.85rem;color:var(--primary);text-transform:uppercase;letter-spacing:0.08em;">Nutrition</span>
        </div>
        <div class="article-card-content">
          <span class="article-card-tag">Nutrition</span>
          <h3>Nutrition marathon : le guide complet pour performer le jour J</h3>
          <p>Stratégie nutritionnelle avant, pendant et après un marathon. Glucides, hydratation et plan de ravitaillement.</p>
        </div>
      </a>
      <a href="/articles/programme-course-debutant" class="article-card fade-in">
        <div style="width:100%;height:200px;background:linear-gradient(135deg,#1a1a2e,#2d1b4e);display:flex;align-items:center;justify-content:center;">
          <span style="font-family:var(--font-heading);font-weight:800;font-size:0.85rem;color:var(--primary);text-transform:uppercase;letter-spacing:0.08em;">Débutant</span>
        </div>
        <div class="article-card-content">
          <span class="article-card-tag">Entraînement</span>
          <h3>Programme course à pied débutant : de 0 à 30 min en 8 semaines</h3>
          <p>Plan progressif pour débuter la course à pied. Du marché-courre à 30 minutes de course continue.</p>
        </div>
      </a>
      <a href="/articles/entrainement-fractionne" class="article-card fade-in">
        <div style="width:100%;height:200px;background:linear-gradient(135deg,#3b0d0d,#5c1a1a);display:flex;align-items:center;justify-content:center;">
          <span style="font-family:var(--font-heading);font-weight:800;font-size:0.85rem;color:var(--primary);text-transform:uppercase;letter-spacing:0.08em;">Performance</span>
        </div>
        <div class="article-card-content">
          <span class="article-card-tag">Entraînement</span>
          <h3>Entraînement fractionné : guide et séances VMA</h3>
          <p>Tout sur le fractionné en course à pied. Types de séances, calcul des allures et progression.</p>
        </div>
      </a>
      <a href="/articles/hydratation-course-a-pied" class="article-card fade-in">
        <div style="width:100%;height:200px;background:linear-gradient(135deg,#0d2a3b,#1a4a5c);display:flex;align-items:center;justify-content:center;">
          <span style="font-family:var(--font-heading);font-weight:800;font-size:0.85rem;color:var(--primary);text-transform:uppercase;letter-spacing:0.08em;">Nutrition</span>
        </div>
        <div class="article-card-content">
          <span class="article-card-tag">Nutrition</span>
          <h3>Hydratation en course à pied : combien boire et quand</h3>
          <p>Guide complet de l'hydratation. Taux de sudation, sodium, protocoles par distance.</p>
        </div>
      </a>
    </div>
    <div style="text-align:center;margin-top:40px;">
      <a href="/articles" class="btn btn-outline">Tous nos articles</a>
    </div>
  </div>
</section>

<!-- Portraits d'athlètes -->
<section class="section-alt">
  <div class="container">
    <h2 class="section-title">Portraits d'athlètes</h2>
    <p class="section-subtitle">Les légendes du trail et de l'ultra-trail : leur parcours, leurs records et les leçons à en tirer pour progresser.</p>
    <div class="features-grid" style="grid-template-columns:repeat(4,1fr);">
      <a href="/articles/kilian-jornet-portrait" class="feature-card fade-in" style="text-decoration:none;color:inherit;text-align:center;overflow:hidden;padding:0;">
        <div style="width:100%;height:180px;overflow:hidden;">
          <img src="/images/athletes/kilian-jornet.webp" alt="Kilian Jornet en compétition de trail" title="Kilian Jornet" style="width:100%;height:100%;object-fit:cover;" loading="lazy" />
        </div>
        <div style="padding:16px;">
          <h3 style="font-size:0.95rem;">Kilian Jornet</h3>
          <p style="font-size:0.82rem;">3x UTMB, roi de l'ultra-trail</p>
        </div>
      </a>
      <a href="/articles/francois-dhaene-portrait" class="feature-card fade-in" style="text-decoration:none;color:inherit;text-align:center;overflow:hidden;padding:0;">
        <div style="width:100%;height:180px;overflow:hidden;">
          <img src="/images/athletes/francois-dhaene.webp" alt="François D'Haene en présentation" title="François D'Haene" style="width:100%;height:100%;object-fit:cover;" loading="lazy" />
        </div>
        <div style="padding:16px;">
          <h3 style="font-size:0.95rem;">François D'Haene</h3>
          <p style="font-size:0.82rem;">4x UTMB, vigneron champion</p>
        </div>
      </a>
      <a href="/articles/courtney-dauwalter-portrait" class="feature-card fade-in" style="text-decoration:none;color:inherit;text-align:center;overflow:hidden;padding:0;">
        <div style="width:100%;height:180px;overflow:hidden;">
          <img src="/images/athletes/courtney-dauwalter.webp" alt="Courtney Dauwalter en ultra-trail" title="Courtney Dauwalter" style="width:100%;height:100%;object-fit:cover;" loading="lazy" />
        </div>
        <div style="padding:16px;">
          <h3 style="font-size:0.95rem;">Courtney Dauwalter</h3>
          <p style="font-size:0.82rem;">2x UTMB, reine de l'ultra</p>
        </div>
      </a>
      <a href="/articles/xavier-thevenard-portrait" class="feature-card fade-in" style="text-decoration:none;color:inherit;text-align:center;overflow:hidden;padding:0;">
        <div style="width:100%;height:180px;overflow:hidden;">
          <img src="/images/athletes/xavier-thevenard.webp" alt="Xavier Thévenard en montagne" title="Xavier Thévenard" style="width:100%;height:100%;object-fit:cover;" loading="lazy" />
        </div>
        <div style="padding:16px;">
          <h3 style="font-size:0.95rem;">Xavier Thévenard</h3>
          <p style="font-size:0.82rem;">3x UTMB, le Jurassien</p>
        </div>
      </a>
    </div>
    <div style="text-align:center;margin-top:24px;">
      <a href="/athletes" class="btn btn-outline">Tous les portraits</a>
    </div>
  </div>
</section>

<!-- Thématiques -->
<section class="section">
  <div class="container">
    <h2 class="section-title">Explorez par thématique</h2>
    <p class="section-subtitle">Course sur route, trail, ultra-endurance - retrouvez nos guides adaptés à votre pratique.</p>
    <div class="features-grid" style="grid-template-columns:repeat(4,1fr);">
      <a href="/articles/plan-entrainement-marathon" class="feature-card fade-in" style="text-decoration:none;color:inherit;text-align:center;">
        <div style="font-family:var(--font-heading);font-weight:800;font-size:1.3rem;color:var(--primary);margin-bottom:12px;">ROUTE</div>
        <h3 style="font-size:1rem;">Course sur route</h3>
        <p>10 km, semi-marathon, marathon : plans d'entraînement et stratégies de course.</p>
      </a>
      <a href="/articles/debuter-trail" class="feature-card fade-in" style="text-decoration:none;color:inherit;text-align:center;">
        <div style="font-family:var(--font-heading);font-weight:800;font-size:1.3rem;color:var(--primary);margin-bottom:12px;">TRAIL</div>
        <h3 style="font-size:1rem;">Trail running</h3>
        <p>Sentiers, montagne, technique de descente et équipement spécifique.</p>
      </a>
      <a href="/articles/kilian-jornet-portrait" class="feature-card fade-in" style="text-decoration:none;color:inherit;text-align:center;">
        <div style="font-family:var(--font-heading);font-weight:800;font-size:1.3rem;color:var(--primary);margin-bottom:12px;">ULTRA</div>
        <h3 style="font-size:1rem;">Ultra-endurance</h3>
        <p>UTMB, Western States, 100 miles : préparation et récits de course.</p>
      </a>
      <a href="/articles/nutrition-marathon" class="feature-card fade-in" style="text-decoration:none;color:inherit;text-align:center;">
        <div style="font-family:var(--font-heading);font-weight:800;font-size:1.3rem;color:var(--primary);margin-bottom:12px;">NUTRITION</div>
        <h3 style="font-size:1rem;">Nutrition sportive</h3>
        <p>Alimentation, hydratation, gels et compléments pour l'effort.</p>
      </a>
    </div>
  </div>
</section>

<!-- Guides populaires -->
<section class="section-alt">
  <div class="container">
    <h2 class="section-title">Guides les plus lus</h2>
    <p class="section-subtitle">Les articles essentiels pour bien démarrer ou progresser.</p>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:20px;">
      <a href="/articles/comment-bien-courir" style="display:flex;gap:16px;align-items:center;padding:20px;background:var(--bg-card);border-radius:var(--radius-lg);text-decoration:none;color:inherit;box-shadow:var(--shadow-sm);transition:transform 0.2s;" class="fade-in">
        <div style="min-width:48px;height:48px;background:var(--primary);border-radius:50%;display:flex;align-items:center;justify-content:center;color:white;font-weight:800;font-family:var(--font-heading);font-size:0.85rem;">01</div>
        <div>
          <h3 style="font-size:0.95rem;margin-bottom:4px;">Comment bien courir : technique et posture</h3>
          <p style="font-size:0.82rem;color:var(--text-dark-secondary);">12 min de lecture</p>
        </div>
      </a>
      <a href="/articles/courir-pour-maigrir" style="display:flex;gap:16px;align-items:center;padding:20px;background:var(--bg-card);border-radius:var(--radius-lg);text-decoration:none;color:inherit;box-shadow:var(--shadow-sm);transition:transform 0.2s;" class="fade-in">
        <div style="min-width:48px;height:48px;background:var(--primary);border-radius:50%;display:flex;align-items:center;justify-content:center;color:white;font-weight:800;font-family:var(--font-heading);font-size:0.85rem;">02</div>
        <div>
          <h3 style="font-size:0.95rem;margin-bottom:4px;">Courir pour maigrir : le guide réaliste</h3>
          <p style="font-size:0.82rem;color:var(--text-dark-secondary);">13 min de lecture</p>
        </div>
      </a>
      <a href="/articles/eviter-blessures-course" style="display:flex;gap:16px;align-items:center;padding:20px;background:var(--bg-card);border-radius:var(--radius-lg);text-decoration:none;color:inherit;box-shadow:var(--shadow-sm);transition:transform 0.2s;" class="fade-in">
        <div style="min-width:48px;height:48px;background:var(--primary);border-radius:50%;display:flex;align-items:center;justify-content:center;color:white;font-weight:800;font-family:var(--font-heading);font-size:0.85rem;">03</div>
        <div>
          <h3 style="font-size:0.95rem;margin-bottom:4px;">Éviter les blessures en course à pied</h3>
          <p style="font-size:0.82rem;color:var(--text-dark-secondary);">14 min de lecture</p>
        </div>
      </a>
      <a href="/articles/que-manger-avant-marathon" style="display:flex;gap:16px;align-items:center;padding:20px;background:var(--bg-card);border-radius:var(--radius-lg);text-decoration:none;color:inherit;box-shadow:var(--shadow-sm);transition:transform 0.2s;" class="fade-in">
        <div style="min-width:48px;height:48px;background:var(--primary);border-radius:50%;display:flex;align-items:center;justify-content:center;color:white;font-weight:800;font-family:var(--font-heading);font-size:0.85rem;">04</div>
        <div>
          <h3 style="font-size:0.95rem;margin-bottom:4px;">Que manger avant un marathon</h3>
          <p style="font-size:0.82rem;color:var(--text-dark-secondary);">11 min de lecture</p>
        </div>
      </a>
      <a href="/articles/bienfaits-course-a-pied" style="display:flex;gap:16px;align-items:center;padding:20px;background:var(--bg-card);border-radius:var(--radius-lg);text-decoration:none;color:inherit;box-shadow:var(--shadow-sm);transition:transform 0.2s;" class="fade-in">
        <div style="min-width:48px;height:48px;background:var(--primary);border-radius:50%;display:flex;align-items:center;justify-content:center;color:white;font-weight:800;font-family:var(--font-heading);font-size:0.85rem;">05</div>
        <div>
          <h3 style="font-size:0.95rem;margin-bottom:4px;">10 bienfaits prouvés de la course à pied</h3>
          <p style="font-size:0.82rem;color:var(--text-dark-secondary);">11 min de lecture</p>
        </div>
      </a>
      <a href="/articles/recuperation-apres-marathon" style="display:flex;gap:16px;align-items:center;padding:20px;background:var(--bg-card);border-radius:var(--radius-lg);text-decoration:none;color:inherit;box-shadow:var(--shadow-sm);transition:transform 0.2s;" class="fade-in">
        <div style="min-width:48px;height:48px;background:var(--primary);border-radius:50%;display:flex;align-items:center;justify-content:center;color:white;font-weight:800;font-family:var(--font-heading);font-size:0.85rem;">06</div>
        <div>
          <h3 style="font-size:0.95rem;margin-bottom:4px;">Récupération après marathon</h3>
          <p style="font-size:0.82rem;color:var(--text-dark-secondary);">12 min de lecture</p>
