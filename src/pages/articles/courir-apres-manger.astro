  <thead>
    <tr><th>Categorie d'aliment</th><th>Exemples</th><th>Temps de vidange gastrique</th><th>Delai avant de courir</th></tr>
  </thead>
  <tbody>
    <tr><td><strong>Liquides sucres</strong></td><td>Jus de fruit, boisson energetique, compote liquide</td><td>20 a 30 min</td><td>30 min</td></tr>
