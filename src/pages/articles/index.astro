---

<BaseLayout
  title="Articles Running et Trail - Guides Nutrition, Entraînement et Équipement"
  description="Guides pratiques pour la course à pied et le trail running. Nutrition marathon, choix de gels énergétiques, entraînement trail et conseils pour débutants."
  canonical="/articles"
>

<section class="hero-compact">
  <div class="container">
    <nav class="breadcrumb">
      <a href="/">Accueil</a>
      <span>/</span>
      <span style="color:var(--primary);">Articles</span>
    </nav>
    <h1>Articles et guides</h1>
    <p>Guides pratiques, conseils nutrition et entraînement pour progresser en course à pied et trail running.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="articles-grid">
      {articles.map(a => (
        <a href={a.url} class="article-card fade-in">
          <div style={`width:100%;height:200px;background:linear-gradient(135deg,var(--bg-darkest),var(--bg-dark));display:flex;align-items:center;justify-content:center;`}>
            <span style="font-family:var(--font-heading);font-weight:800;font-size:0.85rem;color:var(--primary);text-transform:uppercase;letter-spacing:0.08em;">{a.category}</span>
          </div>
          <div class="article-card-content">
            <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;">
              <span class="article-card-tag">{a.category}</span>
              <span style="font-size:0.8rem;color:var(--text-dark-secondary);">{a.readTime}</span>
            </div>
            <h3>{a.title}</h3>
            <p>{a.description}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="section-dark" style="text-align:center;">
  <div class="container">
    <h2 class="section-title" style="color:var(--text-light);">Explorez nos comparatifs</h2>
    <p class="section-subtitle">Gels, électrolytes, boissons isotoniques : trouvez les meilleurs produits.</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
      <a href="/comparatifs/gels-energetiques" class="btn btn-primary">Gels énergétiques</a>
      <a href="/comparatifs/electrolytes" class="btn btn-secondary">Électrolytes</a>
    </div>
  </div>
</section>

</BaseLayout>
