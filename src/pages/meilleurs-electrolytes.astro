---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import '../styles/global.css';

const schemaOrg = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Les 5 meilleurs électrolytes en 2026 pour la course à pied",
  "description": "Sélection des 5 meilleurs électrolytes pour le running et le trail. Classement indépendant basé sur le profil minéral, la digestibilité et le prix.",
  "author": { "@type": "Organization", "name": "Running et Trail" },
  "publisher": { "@type": "Organization", "name": "Running et Trail", "url": "https://running-et-trail.fr" },
  "datePublished": "2026-08-10",
  "dateModified": "2026-08-10"
});

const products = [
  {
    rank: 1,
    brand: "NutriForce",
    name: "Électrolytes en Poudre",
    image: "/images/products/nutriforce-electrolytes.webp",
    score: 9.3,
    price: "24,99 €",
    priceDose: "0,83 €",
    keySpecLabel: "Potassium",
    keySpec: "350 mg",
    bullets: [
      "<strong>4 minéraux + 9 vitamines</strong> + 1000 mg L-glutamine",
      "<strong>350 mg potassium</strong>, 113 mg magnésium, sodium, bicarbonate",
      "Ultra-digeste, dissolution instantanée, enrichi en glutamine",
      "4 saveurs : cassis, fruits rouges, citron vert, menthe",
      "Fabriqué en France, testé en laboratoire"
    ],
    testUrl: "/tests/nutriforce-electrolytes",
    productUrl: "https://nutriforce.fr/product/electrolytes-en-poudre/",
    featured: true
  },
  {
    rank: 2,
    brand: "Precision Hydration",
    name: "PH 1500",
    image: "/images/products/precision-ph1500.webp",
    score: 9.0,
    price: "14,50 €",
    priceDose: "1,45 €",
    keySpecLabel: "Sodium",
    keySpec: "1500 mg",
    bullets: [
      "<strong>1500 mg de sodium</strong> par litre, idéal gros transpirants",
      "Pastilles effervescentes, zéro calorie",
      "Développé à partir de tests de sueur individuels",
      "Utilisé par des athlètes professionnels"
    ],
    testUrl: "/tests/precision-hydration-ph1500",
    productUrl: "https://www.precisionfuelandhydration.com/",
    featured: false
  },
  {
    rank: 3,
    brand: "Nuun",
    name: "Sport Electrolytes",
    image: "/images/products/nuun-sport.webp",
    score: 8.7,
    price: "9,50 €",
    priceDose: "0,95 €",
    keySpecLabel: "Sodium",
    keySpec: "300 mg",
    bullets: [
      "<strong>300 mg de sodium</strong> par pastille effervescente",
      "Seulement 15 calories, sans sucre ajouté",
      "10 pastilles par tube, facile à transporter",
      "Large gamme de saveurs fruitées"
    ],
    testUrl: "/tests/nuun-sport",
    productUrl: "https://nuunlife.com/",
    featured: false
  },
  {
    rank: 4,
    brand: "Nutri&Co",
    name: "Électrolytes Sport",
    image: "/images/products/nutrico-electrolytes.webp",
    score: 8.5,
    price: "22,90 €",
    priceDose: "0,76 €",
    keySpecLabel: "Sodium",
    keySpec: "460 mg/L",
    bullets: [
      "4 électrolytes : <strong>sodium, potassium, magnésium, zinc</strong>",
      "Dosage conforme aux recommandations ACSM",
      "Format poudre, 30 doses par pot",
      "Marque française, clean label"
    ],
    testUrl: "/tests/nutrico-electrolytes",
    productUrl: "https://nutriandco.com/",
    featured: false
  },
  {
    rank: 5,
    brand: "SIS",
    name: "GO Electrolyte",
    image: "/images/products/sis-electrolyte.webp",
    score: 8.3,
    price: "27,99 €",
    priceDose: "1,56 €",
    keySpecLabel: "Glucides",
    keySpec: "36 g",
    bullets: [
      "<strong>36 g de glucides</strong> + électrolytes par dose",
      "Boisson 2-en-1 énergie + hydratation",
      "Osmolarité optimisée pour absorption rapide",
      "Certifié Informed Sport"
    ],
    testUrl: "/tests/sis-go-electrolyte",
    productUrl: "https://www.scienceinsport.com/",
    featured: false
  }
];
---

<BaseLayout
  title="Meilleurs électrolytes 2026 - Top 5 course à pied"
  description="Les 5 meilleurs électrolytes pour la course à pied et le trail en 2026. Sodium, potassium, magnésium : notre sélection indépendante testée sur le terrain."
  canonical="/meilleurs-electrolytes"
  schema={schemaOrg}
>

<section class="hero-compact">
  <div class="container">
    <nav class="breadcrumb">
      <a href="/">Accueil</a>
      <span>/</span>
      <span style="color:var(--primary);">Meilleurs électrolytes</span>
    </nav>
    <h1>Les 5 meilleurs électrolytes en 2026</h1>
    <p>Vous cherchez les meilleurs électrolytes pour vos sorties longues ou vos courses par temps chaud ? Voici notre sélection des 5 produits les plus performants, testés en conditions réelles et classés selon leur profil minéral, leur digestibilité et leur rapport qualité-prix.</p>
  </div>
</section>

<section class="section">
  <div class="container">

    <div class="products-grid">
      {products.map(p => (
        <ProductCard
          rank={p.rank}
          brand={p.brand}
          name={p.name}
          image={p.image}
          score={p.score}
          price={p.price}
          priceDose={p.priceDose}
          keySpec={p.keySpec}
          keySpecLabel={p.keySpecLabel}
          bullets={p.bullets}
          testUrl={p.testUrl}
          productUrl={p.productUrl}
          featured={p.featured}
        />
      ))}
    </div>

    <div style="text-align:center;margin:40px 0 0;">
      <a href="/comparatifs/electrolytes" style="color:var(--primary);font-weight:600;font-size:1.05rem;text-decoration:underline;">Voir le classement complet des 10 meilleurs électrolytes &rarr;</a>
    </div>

    <!-- Guide d'achat rapide -->
    <div style="max-width:800px;margin:64px auto 0;">
      <h2 style="font-size:1.6rem;margin-bottom:24px;">Comment choisir ses électrolytes ?</h2>

      <h3 style="font-size:1.15rem;margin:24px 0 12px;color:var(--primary);">1. Le dosage en sodium</h3>
      <p style="color:var(--text-dark-secondary);line-height:1.8;">Le sodium est le minéral le plus perdu par la sueur : 700 à 1500 mg/L selon les individus. Les meilleurs électrolytes apportent <strong style="color:var(--text-dark);">300 à 600 mg de sodium par heure</strong> d'effort. Les gros transpirants ou les coureurs en climat chaud peuvent avoir besoin de 1000 mg/h ou plus.</p>

      <h3 style="font-size:1.15rem;margin:24px 0 12px;color:var(--primary);">2. L'équilibre potassium-magnésium</h3>
      <p style="color:var(--text-dark-secondary);line-height:1.8;">Les meilleurs électrolytes ne se limitent pas au sodium. Le <strong style="color:var(--text-dark);">potassium</strong> intervient dans la contraction musculaire, le <strong style="color:var(--text-dark);">magnésium</strong> prévient les crampes et participe à la production d'énergie. Un produit complet apporte ces trois minéraux en proportions équilibrées.</p>

      <h3 style="font-size:1.15rem;margin:24px 0 12px;color:var(--primary);">3. Le format adapté à votre pratique</h3>
      <p style="color:var(--text-dark-secondary);line-height:1.8;">Poudre, pastille effervescente ou liquide concentré : chaque format a ses avantages. La <strong style="color:var(--text-dark);">poudre</strong> offre le meilleur rapport qualité-prix et un dosage ajustable. Les <strong style="color:var(--text-dark);">pastilles</strong> sont légères et pratiques pour le trail avec des points d'eau.</p>
    </div>

  </div>
</section>

<!-- CTA unique -->
<section class="section-dark" style="text-align:center;">
  <div class="container">
    <h2 class="section-title" style="color:var(--text-light);">Besoin de plus de détails ?</h2>
    <p class="section-subtitle">Consultez notre comparatif complet avec les 10 meilleurs électrolytes, la méthodologie de test détaillée et la FAQ.</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
      <a href="/comparatifs/electrolytes" class="btn btn-primary">Voir le comparatif complet</a>
      <a href="/comparatifs/gels-energetiques" class="btn btn-secondary">Comparatif gels énergétiques</a>
    </div>
  </div>
</section>

</BaseLayout>
