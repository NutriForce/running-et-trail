---
import BaseLayout from './BaseLayout.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical: string;
  date: string;
  readTime: string;
  category: string;
  ogImage?: string;
  author?: string;
  authorRole?: string;
}

const authors: Record<string, { name: string; role: string; bio: string }> = {
  "julien-moreau": {
    name: "Julien Moreau",
    role: "Ultra-traileur et coach certifié",
    bio: "Finisher de l'UTMB, CCC et Diagonale des Fous. Coach diplômé d'État en athlétisme, spécialisé dans la préparation des courses longues distances. 15 ans d'expérience en endurance."
  },
  "camille-dupont": {
    name: "Camille Dupont",
    role: "Marathonienne et nutritionniste du sport",
    bio: "Record personnel de 2h48 au marathon. Diététicienne-nutritionniste spécialisée dans la nutrition de l'effort. Accompagne des coureurs de tous niveaux depuis 10 ans."
  },
  "thomas-lefevre": {
    name: "Thomas Lefevre",
    role: "Ultra-traileur",
    bio: "Multiple podiums en trail national (80 km du Mont-Blanc, Grand Raid Réunion). Passionné d'endurance et de montagne, il partage son expérience de terrain et ses retours de course."
  }
};

const { title, description, canonical, date, readTime, category, ogImage, author: authorKey, authorRole: authorRoleOverride } = Astro.props;

const author = authorKey && authors[authorKey] ? authors[authorKey] : authors["julien-moreau"];

const schemaOrg = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "author": { "@type": "Person", "name": author.name, "jobTitle": author.role },
  "publisher": { "@type": "Organization", "name": "Running et Trail", "url": "https://running-et-trail.fr" },
  "datePublished": date,
  "dateModified": date
});
---

<BaseLayout title={title} description={description} canonical={canonical} ogImage={ogImage} schema={schemaOrg}>

<section class="hero-compact">
  <div class="container">
    <nav class="breadcrumb">
      <a href="/">Accueil</a>
      <span>/</span>
      <a href="/articles">Articles</a>
      <span>/</span>
      <span style="color:var(--primary);"><slot name="breadcrumb" /></span>
    </nav>
    <span class="article-card-tag">{category}</span>
    <h1 style="margin-top:12px;">{title}</h1>
    <p style="margin-top:12px;font-size:0.9rem;color:var(--text-light-secondary);">Mis à jour le {date} - {readTime} de lecture</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <article class="article-content" style="max-width:800px;margin:0 auto;">
      <slot />

      <div class="author-box">
        <div class="author-avatar">{author.name.split(' ').map(n => n[0]).join('')}</div>
        <div class="author-info">
          <p class="author-name">{author.name}</p>
          <p class="author-role">{author.role}</p>
          <p class="author-bio">{author.bio}</p>
        </div>
      </div>
    </article>
  </div>
</section>

</BaseLayout>

<style is:global>
  .article-content {
    font-size: 1.08rem;
    line-height: 1.9;
    color: var(--text-dark);
  }
  .article-content h2 {
    font-size: 1.55rem;
    margin: 56px 0 20px;
    padding-top: 32px;
    border-top: 1px solid rgba(0,0,0,0.08);
    color: var(--text-dark);
  }
  .article-content h2:first-child {
    border-top: none;
    padding-top: 0;
    margin-top: 32px;
  }
  .article-content h3 {
    font-size: 1.2rem;
    margin: 36px 0 14px;
    color: var(--primary);
  }
  .article-content p {
    margin-bottom: 20px;
    color: var(--text-dark-secondary);
  }
  .article-content strong {
    color: var(--text-dark);
    font-weight: 600;
  }
  .article-content ul, .article-content ol {
    margin: 20px 0;
    padding-left: 28px;
  }
  .article-content ul {
    list-style: none;
    padding-left: 0;
  }
  .article-content ul li {
    position: relative;
    padding-left: 20px;
    margin-bottom: 12px;
    color: var(--text-dark-secondary);
  }
  .article-content ul li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 10px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--primary);
  }
  .article-content ol li {
    margin-bottom: 12px;
    padding-left: 4px;
    color: var(--text-dark-secondary);
  }
  .article-content ol li::marker {
    color: var(--primary);
    font-weight: 700;
  }
  .article-content blockquote {
    border-left: 4px solid var(--primary);
    padding: 20px 28px;
    margin: 32px 0;
    background: var(--bg-alt);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-style: italic;
    color: var(--text-dark);
  }
  .article-content blockquote p {
    margin-bottom: 0;
    color: var(--text-dark);
  }
  .article-content table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 32px 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid rgba(0,0,0,0.1);
  }
  .article-content thead {
    position: sticky;
    top: 0;
  }
  .article-content th {
    background: var(--bg-dark);
    color: var(--text-light);
    padding: 14px 16px;
    text-align: left;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .article-content td {
    padding: 12px 16px;
    border-bottom: 1px solid rgba(0,0,0,0.06);
    vertical-align: top;
    color: var(--text-dark-secondary);
  }
  .article-content tbody tr:nth-child(even) {
    background: rgba(0,0,0,0.02);
  }
  .article-content tbody tr:hover {
    background: rgba(232,93,42,0.04);
  }
  .article-content td strong {
    color: var(--primary-dark);
  }
  .article-content figure {
    margin: 32px 0;
  }
  .article-content figcaption {
    font-size: 0.85rem;
    color: var(--text-dark-secondary);
    margin-top: 8px;
    text-align: center;
  }
  .article-cta {
    background: var(--bg-alt);
    border-radius: var(--radius-lg);
    padding: 32px;
    text-align: center;
    margin: 48px 0;
  }
  .article-cta h3 {
    color: var(--text-dark) !important;
    margin: 0 0 12px !important;
  }
  .article-cta p {
    margin-bottom: 20px !important;
  }
  .author-box {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    padding: 28px;
    margin-top: 56px;
    background: var(--bg-alt);
    border-radius: var(--radius-lg);
    border-left: 4px solid var(--primary);
  }
  .author-avatar {
    width: 56px;
    height: 56px;
    min-width: 56px;
    border-radius: 50%;
    background: var(--primary);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.1rem;
  }
  .author-name {
    font-weight: 700;
    color: var(--text-dark);
    margin-bottom: 2px !important;
    font-size: 1.05rem;
  }
  .author-role {
    color: var(--primary);
    font-size: 0.88rem;
    font-weight: 600;
    margin-bottom: 8px !important;
  }
  .author-bio {
    font-size: 0.92rem;
    color: var(--text-dark-secondary);
    line-height: 1.6;
    margin-bottom: 0 !important;
  }
</style>
